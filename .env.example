# Copy to .env and adjust. Never commit real credentials.

# PostgreSQL connection used by the app (runtime) and the Prisma CLI.
# Local development: `docker compose up -d` starts a matching database.
# Neon: use the pooled connection string (host contains "-pooler") here and
# the direct one in DIRECT_URL (used by migrations).
DATABASE_URL="postgresql://cellarium:cellarium@localhost:5432/cellarium?schema=public"
DIRECT_URL=""
# Connections per app instance (Vercel/serverless: 3-5; Railway/servers: 10).
DATABASE_POOL_MAX="10"
# Long enough to cover Neon waking up from scale-to-zero.
DATABASE_CONNECT_TIMEOUT_MS="10000"

# ─── Authentication ──────────────────────────────────────────────────────────
# Required. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Optional: Google sign-in. Authorized redirect URI in Google Cloud Console:
#   {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Redis (optional) ────────────────────────────────────────────────────────
# Recommended with more than one app instance: shares the data cache, cache
# invalidations and sign-in rate limits. Without it each process keeps its
# own cache and rate limits are stored in PostgreSQL.
REDIS_URL=""
REDIS_KEY_PREFIX="cellarium"

# ─── Client IP behind a proxy (production) ───────────────────────────────────
# Auth rate limits are counted per client IP. Set ONE of these to match your
# hosting (see README): a header only your proxy sets, e.g. "x-real-ip"
# (nginx: proxy_set_header X-Real-IP $remote_addr) or "cf-connecting-ip"
# (Cloudflare); or the proxies' IPs/CIDRs so X-Forwarded-For is read safely.
TRUSTED_IP_HEADER=""
TRUSTED_PROXIES=""

# ─── Transactional email ─────────────────────────────────────────────────────
# "console" logs emails instead of sending them (development). Production:
# "resend" with a domain verified in Resend (SPF/DKIM), see
# docs/deployment.md. Emails go through an outbox table and are retried by
# the scheduled job, so CRON_SECRET must be set too.
EMAIL_PROVIDER="console"
EMAIL_FROM="Cellarium <encomendas@cellarium.pt>"
EMAIL_REPLY_TO=""          # e.g. the customer service mailbox
RESEND_API_KEY=""
ADMIN_NOTIFICATION_EMAIL="" # receives new order and reservation alerts

# ─── Seller details (legal pages) ────────────────────────────────────────────
# Shown on /termos, /devolucoes and /privacidade. Read at build time (the
# pages are static): redeploy after changing them. Missing values show as
# visible "a preencher" markers.
LEGAL_COMPANY_NAME=""   # e.g. "Cellarium, Lda."
LEGAL_TAX_ID=""         # NIPC
LEGAL_ADDRESS=""        # registered office
LEGAL_REGISTRY=""       # e.g. "Conservatória do Registo Comercial de Lisboa, capital social de 5 000 €"
LEGAL_EMAIL=""
LEGAL_PHONE=""

# ─── Product photos ──────────────────────────────────────────────────────────
# "local": a folder on this machine, served at /media (development only).
# "s3": an S3-compatible bucket (Cloudflare R2) shared by every instance;
# required in production. MEDIA_PUBLIC_URL is also read at build time
# (next.config.ts), so set it on the build environment too.
MEDIA_STORAGE="local"
MEDIA_LOCAL_DIR=".data/media"
S3_ENDPOINT=""          # https://<account-id>.r2.cloudflarestorage.com
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
MEDIA_PUBLIC_URL=""     # https://media.example.pt (bucket's public domain)

# Public base URL (payment redirects, provider callbacks and auth).
APP_URL="http://localhost:3000"

# ─── Payments ────────────────────────────────────────────────────────────────
# A method is only offered at checkout when its provider is configured.

# Provider for MB WAY and Multibanco: "ifthenpay" or "eupago".
PAYMENT_PROVIDER="ifthenpay"
# Optional failover: the other provider, used when the first is unavailable
# (configure both providers' keys and webhooks).
PAYMENT_FALLBACK_PROVIDER=""

# ifthenpay (keys from backoffice.ifthenpay.com, format ABC-000000).
# Callback URL to configure in the ifthenpay backoffice:
#   {APP_URL}/api/webhooks/ifthenpay?key=[ANTI_PHISHING_KEY]&orderId=[ORDER_ID]&amount=[AMOUNT]&requestId=[REQUEST_ID]
IFTHENPAY_API_URL="https://api.ifthenpay.com"
IFTHENPAY_MBWAY_KEY=""
IFTHENPAY_MULTIBANCO_KEY=""
IFTHENPAY_ANTI_PHISHING_KEY=""

# eupago (sandbox: https://sandbox.eupago.pt, production: https://clientes.eupago.pt).
# Configure Webhook 2.0 to {APP_URL}/api/webhooks/eupago and copy its secret.
EUPAGO_API_URL="https://sandbox.eupago.pt"
EUPAGO_API_KEY=""
EUPAGO_WEBHOOK_SECRET=""

# Stripe (Klarna). Webhook endpoint: {APP_URL}/api/webhooks/stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Bank transfer details shown to customers.
BANK_TRANSFER_IBAN=""
BANK_TRANSFER_BIC=""
BANK_TRANSFER_HOLDER=""
BANK_TRANSFER_BANK=""

# Scheduled jobs (e.g. expiring unpaid orders): Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""
