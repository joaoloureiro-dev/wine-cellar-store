generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Catalogue ──────────────────────────────────────────────────────────────
//
// Money is stored in integer cents and dimensions in millimetres to avoid
// floating point rounding. Indexes mirror the storefront's real query
// patterns (see comments) and should be re-validated with EXPLAIN ANALYZE
// once production data exists.

enum InstallationType {
  FREESTANDING
  BUILT_IN
  UNDERCOUNTER
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  PREORDER
}

model Brand {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String    @unique
  country     String
  description String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id                  String           @id @default(cuid())
  slug                String           @unique
  sku                 String           @unique
  ean                 String?          @unique
  name                String
  brandId             String
  brand               Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  shortDescription    String
  description         String
  priceCents          Int
  compareAtPriceCents Int?
  capacity            Int
  zones               Int
  installationType    InstallationType
  widthMm             Int
  heightMm            Int
  depthMm             Int
  weightGrams         Int?
  energyClass         String?
  annualEnergyKwh     Int?
  noiseDb             Int?
  reversibleDoor      Boolean?
  uvProtectedGlass    Boolean?
  ledLighting         Boolean?
  lock                Boolean?
  stockQuantity       Int              @default(0)
  stockStatus         StockStatus      @default(OUT_OF_STOCK)
  featured            Boolean          @default(false)
  active              Boolean          @default(true)
  seoTitle            String
  seoDescription      String
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  temperatureZones ProductTemperatureZone[]
  images           ProductImage[]
  reservations     Reservation[]
  orderItems       OrderItem[]
  favorites        Favorite[]

  // Homepage featured products.
  @@index([active, featured])
  // Brand pages and brand filter.
  @@index([brandId, active])
  // Capacity filter and capacity sorting.
  @@index([active, capacity])
  // Price filter and price sorting.
  @@index([active, priceCents])
  // "Novidades" sorting.
  @@index([active, createdAt])
}

model ProductTemperatureZone {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  position   Int
  minCelsius Int
  maxCelsius Int

  // Also serves "temperature reachable" filter lookups per product.
  @@unique([productId, position])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int

  @@unique([productId, position])
}

// ─── Reservations ───────────────────────────────────────────────────────────
//
// A reservation is its own domain entity (not a flag on an order): it has a
// lifecycle, a price snapshot and an append-only event log for auditing.

enum ReservationStatus {
  PENDING
  CONFIRMED
  AWAITING_PAYMENT
  PAID
  CANCELLED
  EXPIRED
}

enum ReservationActor {
  CUSTOMER
  ADMIN
  SYSTEM
}

model Reservation {
  id               String             @id @default(cuid())
  /// Public, unguessable reference shown to the customer (e.g. RSV-7K3P9QXM).
  reference        String             @unique
  status           ReservationStatus  @default(PENDING)
  productId        String
  product          Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity         Int
  /// Unit price at the moment of the reservation.
  unitPriceCents   Int
  customerName     String
  customerEmail    String
  customerPhone    String
  customerNotes    String?
  internalNotes    String?
  privacyConsentAt DateTime
  /// Reservation deadline; set when confirmed (EXPIRED after this date).
  expiresAt        DateTime?
  /// True while units are held for this reservation (set on confirmation
  /// when stock is available; out-of-stock or pre-order items are confirmed
  /// without a hold). Released on cancellation or expiry.
  stockHeld        Boolean            @default(false)
  /// Set when made while signed in; guest reservations keep it null.
  userId           String?
  user             User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  events           ReservationEvent[]

  // Backoffice lists by status, newest first.
  @@index([status, createdAt])
  // Expiry job.
  @@index([status, expiresAt])
  // Customer lookups and per-email abuse limits.
  @@index([customerEmail, createdAt])
  // Duplicate detection and per-product reservation counts.
  @@index([productId, status])
  // Customer account: "as minhas reservas".
  @@index([userId, createdAt])
}

model ReservationEvent {
  id            String             @id @default(cuid())
  reservationId String
  reservation   Reservation        @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  fromStatus    ReservationStatus?
  toStatus      ReservationStatus
  actor         ReservationActor
  note          String?
  createdAt     DateTime           @default(now())

  @@index([reservationId, createdAt])
}

// ─── Orders ─────────────────────────────────────────────────────────────────
//
// Orders snapshot everything needed to honour the purchase (prices, product
// names, address) so later catalogue changes never alter a placed order.
// Stock is decremented atomically when the order is created (stock hold) and
// released if the order is cancelled or expires before payment.

enum OrderStatus {
  AWAITING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  EXPIRED
}

enum PaymentMethod {
  MBWAY
  MULTIBANCO
  BANK_TRANSFER
  KLARNA
}

enum OrderActor {
  CUSTOMER
  ADMIN
  SYSTEM
}

model Order {
  id              String        @id @default(cuid())
  /// Public, unguessable reference shown to the customer (e.g. ENC-7K3P9QXM).
  reference       String        @unique
  /// Client-generated key per checkout attempt: double submits never create
  /// two orders.
  idempotencyKey  String        @unique
  status          OrderStatus   @default(AWAITING_PAYMENT)
  paymentMethod   PaymentMethod
  currency        String        @default("EUR")
  subtotalCents   Int
  shippingCents   Int
  totalCents      Int
  shippingMethod  String
  customerName    String
  customerEmail   String
  customerPhone   String
  /// Portuguese NIF for the invoice (optional).
  taxId           String?
  addressLine1    String
  addressLine2    String?
  postalCode      String
  city            String
  country         String        @default("PT")
  customerNotes   String?
  termsAcceptedAt DateTime
  /// Unpaid orders past this date expire and release their stock.
  paymentDueAt    DateTime
  /// Set when placed while signed in; guest orders keep it null.
  userId          String?
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  items           OrderItem[]
  events          OrderEvent[]
  payments        Payment[]

  // Backoffice lists by status, newest first.
  @@index([status, createdAt])
  // Expiry job: unpaid orders past their payment deadline.
  @@index([status, paymentDueAt])
  @@index([customerEmail, createdAt])
  // Customer account: "as minhas encomendas".
  @@index([userId, createdAt])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName    String
  sku            String
  unitPriceCents Int
  quantity       Int
  lineTotalCents Int

  @@index([orderId])
  @@index([productId])
}

model OrderEvent {
  id         String       @id @default(cuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  actor      OrderActor
  note       String?
  createdAt  DateTime     @default(now())

  @@index([orderId, createdAt])
}

// ─── Payments ───────────────────────────────────────────────────────────────
//
// A payment is never considered complete because the browser said so: only a
// verified provider webhook (or a server-side status check) can mark it PAID.
// An order can have several payment attempts (e.g. an expired MB WAY request
// followed by a new one); at most one is ever PAID.

enum PaymentProvider {
  IFTHENPAY
  EUPAGO
  STRIPE
  /// Bank transfer reconciled manually by the store.
  MANUAL
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
}

model Payment {
  id                String          @id @default(cuid())
  orderId           String
  order             Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider          PaymentProvider
  method            PaymentMethod
  status            PaymentStatus   @default(PENDING)
  amountCents       Int
  currency          String          @default("EUR")
  /// Provider transaction id (ifthenpay RequestId, eupago transactionID or
  /// trid, Stripe Checkout Session id).
  providerReference String?
  mbEntity          String?
  mbReference       String?
  /// Hosted payment page (Klarna via Stripe Checkout).
  checkoutUrl       String?
  failureReason     String?
  expiresAt         DateTime?
  paidAt            DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  events            PaymentEvent[]

  @@unique([provider, providerReference])
  // Latest attempts of an order; expiry job.
  @@index([orderId, createdAt])
  @@index([status, expiresAt])
}

/// Append-only audit log of everything that happened to a payment.
model PaymentEvent {
  id        String   @id @default(cuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  type      String
  message   String?
  /// Sanitised provider data (never secrets or full card data).
  data      Json?
  createdAt DateTime @default(now())

  @@index([paymentId, createdAt])
}

/// Every webhook delivery, for idempotency (each provider event is processed
/// once even if delivered many times) and auditing.
model WebhookDelivery {
  id          String          @id @default(cuid())
  provider    PaymentProvider
  /// Provider event id (Stripe event id, eupago trid, ifthenpay RequestId).
  externalId  String
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime        @default(now())

  @@unique([provider, externalId])
}

// ─── Authentication (Better Auth) ───────────────────────────────────────────
//
// Models and fields follow `npx auth generate` (Better Auth 1.7) so the
// Prisma adapter can read and write them. Passwords live hashed (scrypt) in
// Account.password; sessions are database-backed and revocable.

/// Backoffice access. Not exposed to Better Auth, so it can never be set
/// through the sign-up or profile endpoints; granted with `npm run admin:grant`.
enum UserRole {
  CUSTOMER
  ADMIN
}

model User {
  id            String          @id
  name          String
  email         String
  emailVerified Boolean         @default(false)
  image         String?
  role          UserRole        @default(CUSTOMER)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  sessions      Session[]
  accounts      Account[]
  addresses     Address[]
  favorites     Favorite[]
  orders        Order[]
  reservations  Reservation[]
  auditLogs     AdminAuditLog[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Rate limit counters shared by every app instance.
model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

// ─── Customer account ───────────────────────────────────────────────────────

model Address {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Optional nickname, e.g. "Casa" or "Escritório".
  label         String?
  recipientName String
  phone         String
  addressLine1  String
  addressLine2  String?
  postalCode    String
  city          String
  country       String   @default("PT")
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, createdAt])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  // One row per customer and product; also serves "my favourites" lookups.
  @@unique([userId, productId])
}

// ─── Backoffice ─────────────────────────────────────────────────────────────

/// Append-only record of every change made in the backoffice.
model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  /// Snapshot, so the entry stays readable if the account is deleted.
  actorEmail String
  /// e.g. "order.transition", "payment.confirm_manual", "product.update".
  action     String
  entityType String
  entityId   String
  data       Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([createdAt])
}
